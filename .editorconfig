root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = block_scoped
dotnet_sort_system_directives_first = true

[*.{yml,yaml}]
indent_size = 2

[*.{ps1,iss}]
end_of_line = crlf
