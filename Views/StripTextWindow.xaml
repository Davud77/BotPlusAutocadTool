<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:BotPlusAutocadTool.ViewModels" xmlns:ui="clr-namespace:BotPlusAutocadTool.UI" x:Class="BotPlusAutocadTool.Views.StripTextWindow" mc:Ignorable="d" Title="Сброс оформления текста" Height="530" Width="650" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" SizeToContent="Manual" MinWidth="360" MinHeight="280" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}" Topmost="False" ui:WindowTheme.Enabled="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel LastChildFill="True" Background="{DynamicResource WindowBackground}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="16,8,16,16" DockPanel.Dock="Bottom">
            <Button Content="OK" Command="{Binding OkCommand}" IsDefault="True" Width="80" Margin="0,0,20,0" Padding="5"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}" IsCancel="True" Width="80" Padding="5"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0" CanContentScroll="False" Name="DialogViewport">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <GroupBox Grid.Row="0" Header="Пример действия (Динамическое превью)" Margin="0,0,0,10" Height="80">
                    <Border BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" Margin="5" Background="{DynamicResource ControlBackground}">
                        <TextBlock Text="Пример Текста / Sample Text" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="Red"/>
                                    <Setter Property="FontFamily" Value="Impact"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontStyle" Value="Italic"/>
                                    <Setter Property="TextDecorations" Value="Underline"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Options.Color}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Options.Font}" Value="True">
                                            <Setter Property="FontFamily" Value="Segoe UI"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Options.Width}" Value="True">
                                            <Setter Property="FontWeight" Value="Normal"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Options.Oblique}" Value="True">
                                            <Setter Property="FontStyle" Value="Normal"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Options.Underline}" Value="True">
                                            <Setter Property="TextDecorations" Value="{x:Null}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="BorderBrush" Value="Blue"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Options.Frame}" Value="True">
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </GroupBox>
                <TextBlock Grid.Row="1" Text="Настройки сохраняются автоматически" Margin="0,4,12,4" TextWrapping="Wrap"/>
                <GroupBox Grid.Row="2" Header="Выберите тип форматирования для удаления">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <CheckBox Content="Выравнивание" IsChecked="{Binding Options.Alignment}"/>
                            <CheckBox Content="Цвет" IsChecked="{Binding Options.Color}"/>
                            <CheckBox Content="Шрифт" IsChecked="{Binding Options.Font}"/>
                            <CheckBox Content="Высота" IsChecked="{Binding Options.Height}"/>
                            <CheckBox Content="Перенос строки" IsChecked="{Binding Options.LineFeed}"/>
                            <CheckBox Content="Неразрывный пробел" IsChecked="{Binding Options.NonBreakingSpace}"/>
                            <CheckBox Content="Наклон" IsChecked="{Binding Options.Oblique}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <CheckBox Content="Надчеркивание" IsChecked="{Binding Options.Overline}"/>
                            <CheckBox Content="Абзац" IsChecked="{Binding Options.Paragraph}"/>
                            <CheckBox Content="Дроби и Стеки" IsChecked="{Binding Options.Stacking}"/>
                            <CheckBox Content="Табуляция" IsChecked="{Binding Options.Tabs}"/>
                            <CheckBox Content="Трекинг" IsChecked="{Binding Options.Tracking}"/>
                            <CheckBox Content="Подчеркивание" IsChecked="{Binding Options.Underline}"/>
                            <CheckBox Content="Ширина (Жирность)" IsChecked="{Binding Options.Width}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <CheckBox Content="Маскировка фона" IsChecked="{Binding Options.BackgroundMask}"/>
                            <CheckBox Content="Поля (в текст)" IsChecked="{Binding Options.Fields}"/>
                            <CheckBox Content="Колонки" IsChecked="{Binding Options.Columns}"/>
                            <CheckBox Content="Рамка текста" IsChecked="{Binding Options.Frame}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Top" Margin="10,0,0,0">
                            <Button Content="Выбрать все" Command="{Binding SelectAllCommand}" Width="100" Margin="0,0,0,5" Padding="5"/>
                            <Button Content="Очистить все" Command="{Binding ClearAllCommand}" Width="100" Padding="5"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
