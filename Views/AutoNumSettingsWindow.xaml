<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:BotPlusAutocadTool.ViewModels" xmlns:ui="clr-namespace:BotPlusAutocadTool.UI" x:Class="BotPlusAutocadTool.Views.AutoNumSettingsWindow" Title="Настройки автонумерации" Height="650" Width="540" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}" SizeToContent="Manual" MinWidth="360" MinHeight="280" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" FontFamily="Segoe UI" FontSize="13" Topmost="False" ui:WindowTheme.Enabled="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}" x:Key="SectionHeaderStyle">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel LastChildFill="True" Background="{DynamicResource WindowBackground}">
        <Grid DockPanel.Dock="Bottom" Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="Применить" Command="{Binding OkCommand}" IsDefault="True" MinWidth="120"/>
            <Button Grid.Column="3" Content="Отмена" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="100"/>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0" CanContentScroll="False" Name="DialogViewport">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Параметры нумерации" Style="{StaticResource SectionHeaderStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Префикс" Margin="0,0,0,12"/>
                        <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                        <TextBlock Grid.Row="1" Text="Суффикс" Margin="0,0,0,12"/>
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                        <TextBlock Grid.Row="2" Text="Начальный номер" Margin="0,0,0,12"/>
                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding StartNumberText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                        <TextBlock Grid.Row="3" Text="Шаг" Margin="0,0,0,12"/>
                        <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding StepText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                        <TextBlock Grid.Row="4" Text="Количество знаков"/>
                        <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding DigitsText, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="Режим работы" Style="{StaticResource SectionHeaderStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Порядок" Margin="0,0,0,12"/>
                        <ComboBox Grid.Row="0" Grid.Column="2" SelectedIndex="{Binding OrderIndex}" Margin="0,0,0,12">
                            <ComboBoxItem Content="В порядке выбора"/>
                            <ComboBoxItem Content="Сортировка"/>
                        </ComboBox>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Visibility="{Binding IsSortingModeVisibility}" Margin="0,0,0,12">
                            <ComboBox SelectedIndex="{Binding SortingIndex}">
                                <ComboBoxItem Content="↓→  По строкам (сверху вниз)"/>
                                <ComboBoxItem Content="↑→  По строкам (снизу вверх)"/>
                                <ComboBoxItem Content="→↓  По столбцам (слева направо)"/>
                                <ComboBoxItem Content="←↓  По столбцам (справа налево)"/>
                                <ComboBoxItem Content="→    Только горизонталь"/>
                                <ComboBoxItem Content="↓    Только вертикаль"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="Тип объекта" Margin="0,0,0,12"/>
                        <ComboBox Grid.Row="2" Grid.Column="2" SelectedIndex="{Binding ModeIndex}" Margin="0,0,0,12">
                            <ComboBoxItem Content="Текст / МТекст"/>
                            <ComboBoxItem Content="Мультивыноски"/>
                            <ComboBoxItem Content="Атрибут блока"/>
                            <ComboBoxItem Content="Ячейка в нескольких таблицах"/>
                        </ComboBox>
                        <Grid Grid.Row="3" Grid.ColumnSpan="3" Visibility="{Binding IsAttributeModeVisibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Тег атрибута"/>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableAttributes}" SelectedItem="{Binding AttributeTag, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Text="{Binding AttributeTag, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="4" Content="↻" Command="{Binding RefreshAttributesCommand}" ToolTip="Обновить список атрибутов из выделенного" Padding="10,6" MinWidth="36"/>
                        </Grid>
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Visibility="{Binding IsTableModeVisibility}">
                            <TextBlock Text="Одинаковая ячейка во всех выбранных таблицах. Строки считаются сверху, столбцы слева, начиная с 1 (включая заголовки)." Margin="0,0,0,10"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Строка"/>
                                    <TextBox Text="{Binding TableRowText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Столбец"/>
                                    <TextBox Text="{Binding TableColumnText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <Border Grid.Row="3" Margin="0,16,0,20" Background="{DynamicResource ControlBackground}" BorderBrush="{StaticResource AccentColor}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Предпросмотр:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding PreviewItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ControlBackground}" CornerRadius="4" Padding="12,8" Margin="0,0,8,8" BorderBrush="{StaticResource ControlBorder}" BorderThickness="1">
                                        <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource AccentColor}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
