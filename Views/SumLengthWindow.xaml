<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:BotPlusAutocadTool.UI" x:Class="BotPlusAutocadTool.Views.SumLengthWindow" ui:WindowTheme.Enabled="True" Title="Сумма длин" Width="440" Height="740" MinWidth="340" MinHeight="300" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" ResizeMode="CanResize" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}" Closing="Window_Closing" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Background="{DynamicResource WindowBackground}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12">
                <GroupBox Header="Длина / периметр">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="78"/>
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding CopyLengthCommand}" ToolTip="Скопировать длину" Padding="6">
                            <TextBlock Text="{Binding TotalLengthFormatted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="22" FontWeight="SemiBold"/>
                        </Button>
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding LengthUnitIndex}" Margin="8,0,0,0">
                            <ComboBoxItem Content="мм"/>
                            <ComboBoxItem Content="м"/>
                            <ComboBoxItem Content="км"/>
                        </ComboBox>
                    </Grid>
                </GroupBox>
                <GroupBox Header="Площадь" Visibility="{Binding HasTotalArea, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="78"/>
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding CopyAreaCommand}" Padding="6" ToolTip="Скопировать площадь">
                            <TextBlock Text="{Binding TotalAreaFormatted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="20" FontWeight="SemiBold"/>
                        </Button>
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding AreaUnitIndex}" Margin="8,0,0,0">
                            <ComboBoxItem Content="мм²"/>
                            <ComboBoxItem Content="м²"/>
                            <ComboBoxItem Content="км²"/>
                        </ComboBox>
                    </Grid>
                </GroupBox>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Масштаб" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Text="{Binding ScaleNumerator, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text=" : " VerticalAlignment="Center"/>
                    <TextBox Grid.Column="3" Text="{Binding ScaleDenominator, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/>
                </Grid>
                <TextBlock Margin="0,0,0,12">
                    <Run Text="Объектов: "/>
                    <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                    <Run Text="    Типов: "/>
                    <Run Text="{Binding GroupCount, Mode=OneWay}"/>
                </TextBlock>
                <Expander Header="Калькулятор" IsExpanded="True" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12">
                    <StackPanel Margin="0,10,0,0">
                        <TextBox Text="{Binding CalculatorExpression, UpdateSourceTrigger=PropertyChanged}" ToolTip="Например: L * 1,15 + 250. Поддерживаются скобки, проценты и степень.">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding CalculateCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Content="{Binding CalculatorResult}" Command="{Binding CopyCalculatorCommand}" ToolTip="Скопировать результат" FontSize="20" FontWeight="SemiBold" HorizontalContentAlignment="Right" Margin="0,6,0,6"/>
                        <TextBlock Text="{Binding CalculatorError}" Foreground="#FFB99B" Margin="0,0,0,6"/>
                        <UniformGrid Columns="5">
                            <Button Content="7" Command="{Binding CalculatorKeyCommand}" CommandParameter="7" Margin="2" MinWidth="0" Padding="4,5"/>
                            <Button Content="8" Command="{Binding CalculatorKeyCommand}" CommandParameter="8" Margin="2" MinWidth="0" Padding="4,5"/>
                            <Button Content="9" Command="{Binding CalculatorKeyCommand}" CommandParameter="9" Margin="2" MinWidth="0" Padding="4,5"/>
                            <Button Content="÷" Command="{Binding CalculatorKeyCommand}" CommandParameter="/" Margin="2" MinWidth="0" Padding="4,5"/>
                            <Button Content="C" Command="{Binding CalculatorKeyCommand}" CommandParameter="C" Margin="2" MinWidth="0" Padding="4,5"/>
                            <Button Content="4" Command="{Binding CalculatorKeyCommand}" CommandParameter="4" Margin="2" MinWidth="0" Padding="4,5"/>
                            <Button Content="5" Command="{Binding CalculatorKeyCommand}" CommandParameter="5" Margin="2" MinWidth="0" Padding="4,5"/>
                            <Button Content="6" Command="{Binding CalculatorKeyCommand}" CommandParameter="6" Margin="2" MinWidth="0" Padding="4,5"/>
                            <Button Content="×" Command="{Binding CalculatorKeyCommand}" CommandParameter="*" Margin="2" MinWidth="0" Padding="4,5"/>
                            <Button Content="⌫" Command="{Binding CalculatorKeyCommand}" CommandParameter="Back" Margin="2" MinWidth="0" Padding="4,5"/>
                            <Button Content="1" Command="{Binding CalculatorKeyCommand}" CommandParameter="1" Margin="2" MinWidth="0" Padding="4,5"/>
                            <Button Content="2" Command="{Binding CalculatorKeyCommand}" CommandParameter="2" Margin="2" MinWidth="0" Padding="4,5"/>
                            <Button Content="3" Command="{Binding CalculatorKeyCommand}" CommandParameter="3" Margin="2" MinWidth="0" Padding="4,5"/>
                            <Button Content="−" Command="{Binding CalculatorKeyCommand}" CommandParameter="-" Margin="2" MinWidth="0" Padding="4,5"/>
                            <Button Content="(" Command="{Binding CalculatorKeyCommand}" CommandParameter="(" Margin="2" MinWidth="0" Padding="4,5"/>
                            <Button Content="0" Command="{Binding CalculatorKeyCommand}" CommandParameter="0" Margin="2" MinWidth="0" Padding="4,5"/>
                            <Button Content="," Command="{Binding CalculatorKeyCommand}" CommandParameter="." Margin="2" MinWidth="0" Padding="4,5"/>
                            <Button Content="%" Command="{Binding CalculatorKeyCommand}" CommandParameter="%" Margin="2" MinWidth="0" Padding="4,5"/>
                            <Button Content="+" Command="{Binding CalculatorKeyCommand}" CommandParameter="+" Margin="2" MinWidth="0" Padding="4,5"/>
                            <Button Content=")" Command="{Binding CalculatorKeyCommand}" CommandParameter=")" Margin="2" MinWidth="0" Padding="4,5"/>
                            <Button Content="L" Command="{Binding CalculatorKeyCommand}" CommandParameter="L" Margin="2" MinWidth="0" Padding="4,5"/>
                            <Button Content="A" Command="{Binding CalculatorKeyCommand}" CommandParameter="A" Margin="2" MinWidth="0" Padding="4,5"/>
                            <Button Content="^" Command="{Binding CalculatorKeyCommand}" CommandParameter="^" Margin="2" MinWidth="0" Padding="4,5"/>
                            <Button Content="=" Command="{Binding CalculateCommand}" CommandParameter="=" Margin="2" MinWidth="0" Padding="4,5"/>
                            <Button Content="Копия" Command="{Binding CopyCalculatorCommand}" CommandParameter="Copy" Margin="2" MinWidth="0" Padding="4,5"/>
                        </UniformGrid>
                        <TextBlock Text="L — длина, A — площадь в выбранных выше единицах. Например: L × 1,15. Результат — число." Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Expander>
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8">
                                <Expander.Header>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ObjectType}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding TotalLengthFormatted}"/>
                                        <TextBlock Text="{Binding TotalAreaFormatted}" Visibility="{Binding HasArea, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.ZoomToObjectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Margin="0,2">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding CoordinatesInfo}" FontSize="11"/>
                                                    <TextBlock Text="{Binding LengthFormatted}"/>
                                                    <TextBlock Text="{Binding AreaFormatted}" Visibility="{Binding HasArea, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
