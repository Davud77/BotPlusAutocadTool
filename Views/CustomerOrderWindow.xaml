<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:BotPlusAutocadTool.UI" x:Class="BotPlusAutocadTool.Views.CustomerOrderWindow" Title="Сформировать заказчику" SizeToContent="Manual" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Width="530" Height="440" MinWidth="360" MinHeight="280" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}" Topmost="False" ui:WindowTheme.Enabled="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel LastChildFill="True" Background="{DynamicResource WindowBackground}">
        <DockPanel LastChildFill="False" DockPanel.Dock="Bottom" Margin="16,8,16,16">
            <Button Content="OK" Width="120" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Отмена" Width="120" IsCancel="True" Click="Cancel_Click"/>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0" CanContentScroll="False" Name="DialogViewport">
            <StackPanel Margin="16">
                <TextBlock Text="Выберите операции:" FontSize="14" Margin="0,0,0,10"/>
                <CheckBox Content="Создать новый файл" IsChecked="{Binding CreateNewFile}" Margin="0,0,0,6"/>
                <CheckBox Content="Расчленить блоки" IsChecked="{Binding ExplodeBlocks}" Margin="0,0,0,6"/>
                <CheckBox Content="Расчленить полилинии" IsChecked="{Binding ExplodePolylines}" Margin="0,0,0,6"/>
                <CheckBox Content="Расчленить текст" IsChecked="{Binding ExplodeText}" Margin="0,0,0,6"/>
                <CheckBox Content="Выполнить очистку" IsChecked="{Binding PurgeUnused}" Margin="0,0,0,6"/>
                <CheckBox Content="Запретить копирование" IsChecked="{Binding BlockCopy}" Margin="0,0,0,12"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
