<Window x:Class="BotPlusAutocadTool.Views.UpdateDownloadWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:BotPlusAutocadTool.UI"
    Title="Обновление BotPlus AT" Width="570" Height="350" MinWidth="390" MinHeight="300"
    WindowStartupLocation="CenterOwner" ResizeMode="CanResize" FontFamily="Segoe UI" FontSize="13"
    Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}" ui:WindowTheme.Enabled="True">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Styles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <DockPanel Background="{DynamicResource WindowBackground}">
        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="16,8,16,16">
            <Button x:Name="FolderButton" Content="Открыть папку" Click="OpenFolderClick" Visibility="Collapsed" Margin="0,0,8,0"/>
            <Button x:Name="DownloadButton" Content="Обновить" Click="DownloadClick" IsDefault="True" Margin="0,0,8,0"/>
            <Button x:Name="CloseButton" Content="Позже" Click="CloseClick"/>
        </WrapPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">
                <TextBlock x:Name="VersionText" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <TextBlock Text="Нажмите «Обновить» — установщик сразу скачается с GitHub. После загрузки сохраните чертежи, закройте AutoCAD и запустите скачанный EXE." Margin="0,0,0,16"/>
                <ProgressBar x:Name="DownloadProgress" Height="18" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,0,0,10"/>
                <TextBlock x:Name="StatusText" Text="Загрузка начнётся после нажатия «Обновить»."/>
                <TextBlock x:Name="SavedPathText" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
