<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:BotPlusAutocadTool.UI" x:Class="BotPlusAutocadTool.Views.AboutWindow" Title="BotPlus AT — сервис и настройки" Width="640" Height="760" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}" SizeToContent="Manual" MinWidth="360" MinHeight="280" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" Topmost="False" ui:WindowTheme.Enabled="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel LastChildFill="True" Background="{DynamicResource WindowBackground}">
        <WrapPanel DockPanel.Dock="Bottom" Margin="16,8,16,16">
            <Button Content="Сохранить" Click="SaveClick" IsDefault="True" Margin="0,0,8,0" Padding="12,8"/>
            <Button Content="По умолчанию" Click="ResetClick" Margin="0,0,8,0" Padding="12,8"/>
            <Button Content="Страница проекта" Click="OpenProject" Margin="0,0,8,0" Padding="12,8"/>
            <Button Content="Журнал ошибок" Click="OpenLogs" Margin="0,0,8,0" Padding="12,8"/>
            <Button Content="Закрыть" IsCancel="True" Click="CloseWindow" Padding="12,8"/>
        </WrapPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0" CanContentScroll="False" Name="DialogViewport">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                    <Image Width="64" Height="64" Stretch="Uniform" Margin="0,0,18,0" Source="/BotPlusAutocadTool;component/Resources/logo.png"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="BotPlus AT" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextPrimary}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="Инструменты для работы с чертежами AutoCAD" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <GroupBox Grid.Row="2" Header="Обновления" x:Name="UpdatesSection">
                    <StackPanel>
                        <Button Content="Проверить обновления" Click="CheckUpdates" HorizontalAlignment="Left" Padding="12,8" Margin="0,0,0,10"/>
                        <CheckBox x:Name="AutoUpdateCheck" Content="Проверять обновления автоматически" IsChecked="{Binding AutoCheckUpdates}"/>
                        <CheckBox x:Name="PrereleaseUpdateCheck" Content="Включать предварительные выпуски" IsChecked="{Binding IncludePrereleaseUpdates}"/>
                        <TextBlock Text="При запуске AutoCAD и затем раз в сутки. Установка — по вашему выбору." Foreground="{DynamicResource TextPrimary}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,2"/>
                    </StackPanel>
                </GroupBox>
                <StackPanel Grid.Row="3" x:Name="SettingsSection">
                    <GroupBox Header="Форматка">
                        <StackPanel>
                            <TextBlock Text="Масштаб вставки WM_FORMAT"/>
                            <TextBox Text="{Binding FrameInsertionScale, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,6,0,6"/>
                            <TextBlock Text="1 — размер на бумаге; 100 — рамка для модели в масштабе 1:100. Единицы DWG учитываются автоматически." TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Пакетная печать">
                        <StackPanel>
                            <TextBlock Text="Масштаб по умолчанию"/>
                            <ComboBox SelectedIndex="{Binding PlotScaleIndex}" Margin="0,6,0,10">
                                <ComboBoxItem Content="1:1"/><ComboBoxItem Content="1:100"/>
                            </ComboBox>
                            <TextBlock Text="Папка PDF (пусто — рядом с DWG)" TextWrapping="Wrap"/>
                            <DockPanel Margin="0,6,0,6">
                                <Button DockPanel.Dock="Right" Content="…" Click="BrowseOutputClick" MinWidth="32" Width="32" Padding="4" Margin="6,0,0,0" ToolTip="Выбрать папку PDF"/>
                                <TextBox x:Name="OutputFolderBox" Text="{Binding PlotOutputDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <CheckBox Content="Печатать в фоне" IsChecked="{Binding PlotInBackground}"/>
                            <CheckBox Content="Учитывать прозрачность" IsChecked="{Binding PlotTransparency}"/>
                            <CheckBox IsChecked="{Binding KeepExistingPdfFiles}"><TextBlock Text="Сохранять существующие PDF, добавляя индекс к новому файлу" TextWrapping="Wrap"/></CheckBox>
                            <TextBlock Text="Если имя занято: файл_2.pdf, файл_3.pdf и далее. При снятой галочке PDF с тем же именем заменяется." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <CheckBox Content="Открыть папку после печати" IsChecked="{Binding OpenFolderAfterPlot}"/>
                            <CheckBox Content="Открыть файл после печати" IsChecked="{Binding OpenFileAfterPlot}"/>
                            <TextBlock Text="При печати по листам открывается первый PDF, чтобы не запускать множество окон." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Сумма длин">
                        <StackPanel>
                            <TextBlock Text="Масштаб: числитель / знаменатель"/>
                            <UniformGrid Columns="2" Margin="0,6,0,10">
                                <TextBox Text="{Binding ScaleNumerator, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,0,6,0"/>
                                <TextBox Text="{Binding ScaleDenominator, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                            </UniformGrid>
                            <TextBlock Text="Длина"/>
                            <ComboBox SelectedIndex="{Binding LengthUnit}" Margin="0,6,0,10">
                                <ComboBoxItem Content="мм"/><ComboBoxItem Content="м"/><ComboBoxItem Content="км"/>
                            </ComboBox>
                            <TextBlock Text="Площадь"/>
                            <ComboBox SelectedIndex="{Binding AreaUnit}" Margin="0,6,0,0">
                                <ComboBoxItem Content="мм²"/><ComboBoxItem Content="м²"/><ComboBoxItem Content="км²"/>
                            </ComboBox>
                        </StackPanel>
                    </GroupBox>
                    <TextBlock Text="Галочки сохраняются сразу. Для чисел и папки нажмите «Сохранить». Новые значения применяются при следующем открытии соответствующей команды." TextWrapping="Wrap" Margin="0,0,0,12"/>
                </StackPanel>
                <TextBlock Grid.Row="4" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap">
            Исходный код и условия AGPLv3 доступны на GitHub.
            Журнал диагностики хранится только на этом компьютере.
        </TextBlock>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
