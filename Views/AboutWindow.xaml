<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:BotPlusAutocadTool.UI" x:Class="BotPlusAutocadTool.Views.AboutWindow" Title="BotPlus AT — о программе" Width="540" Height="520" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}" SizeToContent="Manual" MinWidth="360" MinHeight="280" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" Topmost="False" ui:WindowTheme.Enabled="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel LastChildFill="True" Background="{DynamicResource WindowBackground}">
        <WrapPanel DockPanel.Dock="Bottom" Margin="16,8,16,16">
            <Button Content="Страница проекта" Click="OpenProject" Margin="0,0,8,0" Padding="12,8"/>
            <Button Content="Журнал ошибок" Click="OpenLogs" Margin="0,0,8,0" Padding="12,8"/>
            <Button Content="Закрыть" IsCancel="True" Click="CloseWindow" Padding="12,8"/>
        </WrapPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0" CanContentScroll="False" Name="DialogViewport">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                    <Image Width="64" Height="64" Stretch="Uniform" Margin="0,0,18,0" Source="/BotPlusAutocadTool;component/Resources/logo.png"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="BotPlus AT" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextPrimary}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <TextBlock Text="Инструменты для работы с чертежами AutoCAD" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Button Content="Настройки" Click="OpenSettings" HorizontalAlignment="Left" Padding="12,8" ToolTip="Масштаб форматки, печать, единицы измерения и обновления."/>
                </StackPanel>
                <GroupBox Grid.Row="2" Header="Обновления">
                    <StackPanel>
                        <Button Content="Проверить обновления" Click="CheckUpdates" HorizontalAlignment="Left" Padding="12,8" Margin="0,0,0,10"/>
                        <CheckBox x:Name="AutoUpdateCheck" Content="Проверять обновления автоматически" Checked="UpdateSettingsChanged" Unchecked="UpdateSettingsChanged"/>
                        <CheckBox x:Name="PrereleaseUpdateCheck" Content="Включать предварительные выпуски" Checked="UpdateSettingsChanged" Unchecked="UpdateSettingsChanged"/>
                        <TextBlock Text="При запуске AutoCAD и затем раз в сутки. Установка — по вашему выбору." Foreground="{DynamicResource TextPrimary}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,2"/>
                    </StackPanel>
                </GroupBox>
                <TextBlock Grid.Row="3" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap">
            Исходный код и условия AGPLv3 доступны на GitHub.
            Журнал диагностики хранится только на этом компьютере.
        </TextBlock>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
