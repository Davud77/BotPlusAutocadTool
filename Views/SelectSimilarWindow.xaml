<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:BotPlusAutocadTool.UI" x:Class="BotPlusAutocadTool.Views.SelectSimilarWindow" Title="Выбор по образцу" SizeToContent="Manual" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}" Width="760" Height="680" MinWidth="360" MinHeight="280" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource TextPrimary}" Topmost="False" ui:WindowTheme.Enabled="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel LastChildFill="True" Background="{DynamicResource WindowBackground}">
        <WrapPanel HorizontalAlignment="Right" Margin="16,8,16,16" DockPanel.Dock="Bottom">
            <CheckBox Content="Запомнить настройки" IsChecked="{Binding Options.RememberSettings}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Сохранить (Выбрать)" Command="{Binding ExecuteCommand}" IsDefault="True"/>
        </WrapPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0" CanContentScroll="False" Name="DialogViewport">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <GroupBox Header="ОБЩИЕ НАСТРОЙКИ">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <CheckBox Content="Добавлять объекты-образцы в набор" IsChecked="{Binding Options.AddSourceObjects}"/>
                            <CheckBox Content="Одинаковые типы" IsChecked="{Binding Options.MatchType}"/>
                            <CheckBox Content="На одинаковом слое" IsChecked="{Binding Options.MatchLayer}"/>
                            <CheckBox Content="С одинаковым цветом" IsChecked="{Binding Options.MatchColor}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <CheckBox Content="С одинаковым типом линий" IsChecked="{Binding Options.MatchLinetype}"/>
                            <CheckBox Content="С одинаковым масштабом типа линий" IsChecked="{Binding Options.MatchLinetypeScale}"/>
                            <CheckBox Content="С одинаковым весом линий" IsChecked="{Binding Options.MatchLineWeight}"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <GroupBox Header="БЛОКИ">
                            <StackPanel>
                                <CheckBox Content="Именем блока" IsChecked="{Binding Options.BlockName}"/>
                                <CheckBox Content="Масштабом блока" IsChecked="{Binding Options.BlockScale}"/>
                                <CheckBox Content="Значением любого атрибута" IsChecked="{Binding Options.BlockAnyAttribute}"/>
                                <CheckBox Content="Значением всех атрибутов" IsChecked="{Binding Options.BlockAllAttributes}"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="МУЛЬТИВЫНОСКИ">
                            <CheckBox Content="Содержимым текста" IsChecked="{Binding Options.MLeaderContent}"/>
                        </GroupBox>
                        <GroupBox Header="ОТРЕЗКИ">
                            <CheckBox Content="Длиной отрезка" IsChecked="{Binding Options.LineLength}"/>
                        </GroupBox>
                        <GroupBox Header="РАЗМЕРЫ">
                            <StackPanel>
                                <CheckBox Content="Величиной размера" IsChecked="{Binding Options.DimValue}"/>
                                <CheckBox Content="Текстовой строкой" IsChecked="{Binding Options.DimTextOverride}"/>
                                <CheckBox Content="Размерным стилем" IsChecked="{Binding Options.DimStyle}"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <GroupBox Header="ОКРУЖНОСТИ">
                            <CheckBox Content="Радиусом" IsChecked="{Binding Options.CircleRadius}"/>
                        </GroupBox>
                        <GroupBox Header="ОДНОСТРОЧНЫЙ ТЕКСТ">
                            <StackPanel>
                                <CheckBox Content="Содержимым текста" IsChecked="{Binding Options.TextContent}"/>
                                <CheckBox Content="Текстовым стилем" IsChecked="{Binding Options.TextStyle}"/>
                                <CheckBox Content="Высотой текста" IsChecked="{Binding Options.TextHeight}"/>
                                <CheckBox Content="Количеством символов" IsChecked="{Binding Options.TextLength}"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="МНОГОСТРОЧНЫЙ ТЕКСТ">
                            <StackPanel>
                                <CheckBox Content="Содержимым текста" IsChecked="{Binding Options.MTextContent}"/>
                                <CheckBox Content="Текстовым стилем" IsChecked="{Binding Options.MTextStyle}"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="ШТРИХОВКИ">
                            <StackPanel>
                                <CheckBox Content="Образцом штриховки" IsChecked="{Binding Options.HatchPattern}"/>
                                <CheckBox Content="Масштабом штриховки" IsChecked="{Binding Options.HatchScale}"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="ПОЛИЛИНИИ">
                            <StackPanel>
                                <CheckBox Content="Длиной полилинии" IsChecked="{Binding Options.PolylineLength}"/>
                                <CheckBox Content="Глобальной шириной" IsChecked="{Binding Options.PolylineGlobalWidth}"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
