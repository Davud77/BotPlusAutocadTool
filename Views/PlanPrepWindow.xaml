<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:BotPlusAutocadTool.ViewModels" xmlns:ui="clr-namespace:BotPlusAutocadTool.UI" x:Class="BotPlusAutocadTool.Views.PlanPrepWindow" Title="Подготовка планов" SizeToContent="Manual" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}" Width="530" Height="550" MinWidth="360" MinHeight="280" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource TextPrimary}" Topmost="False" ui:WindowTheme.Enabled="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel LastChildFill="True" Background="{DynamicResource WindowBackground}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,8,16,16" DockPanel.Dock="Bottom">
            <Button Content="Выполнить" Command="{Binding ExecuteCommand}" IsDefault="True" Margin="0,0,10,0"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}" IsCancel="True"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0" CanContentScroll="False" Name="DialogViewport">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Выберите операции для обработки плана:" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>
                <Border Grid.Row="1" Background="{DynamicResource ControlBackground}" CornerRadius="6" Padding="16" BorderBrush="{StaticResource ControlBorder}" BorderThickness="1">
                    <StackPanel>
                        <CheckBox Content="1. Взорвать все блоки (вкл. вложенные и закрытые)" IsChecked="{Binding Options.ExplodeAllBlocks}"/>
                        <CheckBox Content="2. Взорвать все штриховки" IsChecked="{Binding Options.ExplodeHatches}"/>
                        <CheckBox Content="3. Удалить Solid штриховки" IsChecked="{Binding Options.DeleteSolidHatches}"/>
                        <CheckBox Content="4. Удалить маскировки (Wipeout)" IsChecked="{Binding Options.DeleteWipeouts}"/>
                        <CheckBox Content="5. Удалить точки" IsChecked="{Binding Options.DeletePoints}"/>
                        <CheckBox Content="6. Превратить в полилинии и соединить" IsChecked="{Binding Options.JoinLines}"/>
                        <CheckBox Content="7. Удалить короткие линии (меньше 0.01)" IsChecked="{Binding Options.DeleteShortSegments}"/>
                        <CheckBox Content="8. Сменить цвет на серый (252)" IsChecked="{Binding Options.SetGrayColor}"/>
                        <Border Height="1" Background="{StaticResource ControlBorder}" Margin="0,12"/>
                        <CheckBox x:Name="CreateBlockCheck" Content="9. Создать единый Блок" IsChecked="{Binding Options.CreateBlock}" FontWeight="SemiBold"/>
                        <CheckBox Content="Базовая точка" IsChecked="{Binding Options.PickBasePoint}" IsEnabled="{Binding IsChecked, ElementName=CreateBlockCheck}" Margin="20,4,0,0" ToolTip="После подтверждения выберите базовую точку будущего блока. Без галочки используется центр геометрии."/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
