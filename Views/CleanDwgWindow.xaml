<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:BotPlusAutocadTool.UI" x:Class="BotPlusAutocadTool.Views.CleanDwgWindow" Title="Очистка чертежа" SizeToContent="Manual" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}" Width="580" Height="650" MinWidth="360" MinHeight="280" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource TextPrimary}" Topmost="False" ui:WindowTheme.Enabled="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel LastChildFill="True" Background="{DynamicResource WindowBackground}">
        <WrapPanel DockPanel.Dock="Bottom" Margin="12">
            <Button Content="Выбрать все" Command="{Binding SelectAllCommand}" Margin="4"/>
            <Button Content="Сбросить" Command="{Binding ClearAllCommand}" Margin="4"/>
            <Button Content="ОК" Command="{Binding ExecuteCommand}" IsDefault="True" Margin="4" MinWidth="80"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="80" Margin="4"/>
        </WrapPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0" CanContentScroll="False" Name="DialogViewport">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Очистка чертежа" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="18" Margin="0,0,0,16"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <GroupBox Header="ВИЗУАЛЬНЫЕ ОБЪЕКТЫ">
                            <StackPanel>
                                <CheckBox Content="Удалить точки" IsChecked="{Binding Options.Points}"/>
                                <CheckBox Content="Удалить маскировки" IsChecked="{Binding Options.Wipeouts}"/>
                                <CheckBox Content="Удалить пустой текст" IsChecked="{Binding Options.BlankText}"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="СЛОВАРИ И ТАБЛИЦЫ">
                            <StackPanel>
                                <CheckBox Content="Удалить группы" IsChecked="{Binding Options.Groups}"/>
                                <CheckBox Content="Удалить фильтры слоев" IsChecked="{Binding Options.LayerFilters}"/>
                                <CheckBox Content="Удалить согласованные слои" IsChecked="{Binding Options.LayerReconcile}"/>
                                <CheckBox Content="Удалить RegApps" IsChecked="{Binding Options.RegApps}"/>
                                <CheckBox Content="Удалить список масштабов" IsChecked="{Binding Options.ScaleList}"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <GroupBox Header="МУСОР">
                            <StackPanel>
                                <CheckBox Content="Удалить VBA макросы" IsChecked="{Binding Options.VbaMacros}"/>
                                <CheckBox Content="Удалить стили линий DGN" IsChecked="{Binding Options.DgnLineStyles}"/>
                                <CheckBox Content="Удалить сторонние словари" IsChecked="{Binding Options.Dictionaries}"/>
                                <CheckBox Content="Очистить историю 3D тел" IsChecked="{Binding Options.SolidHistory}"/>
                                <CheckBox Content="Удалить настройки печати" IsChecked="{Binding Options.PageSetups}"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="ДЕЙСТВИЯ">
                            <StackPanel>
                                <CheckBox Content="Очистить все (_PURGE)" IsChecked="{Binding Options.PurgeAll}" FontWeight="SemiBold"/>
                                <CheckBox Content="Проверка ошибок (_AUDIT)" IsChecked="{Binding Options.Audit}"/>
                                <CheckBox Content="Сохранить документ" IsChecked="{Binding Options.SaveDoc}"/>
                                <TextBlock Text="Настройки сохраняются автоматически" Margin="0,4,12,4" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
