<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:BotPlusAutocadTool.ViewModels" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:ui="clr-namespace:BotPlusAutocadTool.UI" x:Class="BotPlusAutocadTool.Views.BatchPlotWindow" mc:Ignorable="d" x:Name="TheWindow" Title="Пакетная печать форматов" Height="620" Width="1000" MinHeight="280" MinWidth="360" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="{DynamicResource WindowBackground}" SizeToContent="Manual" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource TextPrimary}" Topmost="False" ui:WindowTheme.Enabled="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <vm:InverseBoolConverter x:Key="InverseBool"/>
            <Style x:Key="ExcelFillThumb" TargetType="Thumb">
                <Setter Property="Width" Value="10"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Bottom"/>
                <Setter Property="Cursor" Value="Cross"/>
                <Setter Property="Opacity" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="1"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=IsMouseOver}" Value="True">
                        <Setter Property="Opacity" Value="1"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel LastChildFill="True" Background="{DynamicResource WindowBackground}">
        <Border DockPanel.Dock="Bottom" Margin="16,8,16,16" Padding="8" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1">
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="4"/>
                <Button Content="Вставить таблицу в модель" Command="{Binding InsertIndexCommand}" Margin="4"/>
                <Button Content="Записать атрибуты" Command="{Binding UpdateAttributesCommand}" Margin="4"/>
                <CheckBox Content="В фоне" IsChecked="{Binding PlotInBackground}" VerticalAlignment="Center" Margin="12,4"/>
                <Button Content="PDF-сшивка" Command="{Binding PlotCommand}" Margin="4"/>
                <Button Content="PDF по листам" Command="{Binding PlotBySheetsCommand}" Margin="4"/>
            </WrapPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0" CanContentScroll="False" Name="DialogViewport">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="1" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding StatusMessage}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <WrapPanel VerticalAlignment="Center" Grid.Row="1" Margin="0,8,0,0">
                            <WrapPanel VerticalAlignment="Center">
                                <Button Content="Указать форматку" Command="{Binding SetFormatkaCommand}" Height="28" Margin="0,0,8,6" Padding="10,3" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" ToolTip="Выбери блок в чертеже: его имя и слой станут текущим фильтром поиска форматков."/>
                                <Button Content="Выбрать форматки" Command="{Binding SelectFormatkiCommand}" Height="28" Padding="10,3" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" ToolTip="Выберите в чертеже форматки, которые должны попасть в выпуск." Margin="0,0,8,6"/>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                <ProgressBar IsIndeterminate="True" Width="120" Height="20" Margin="0,0,10,0"/>
                                <TextBlock Text="Обработка..." FontStyle="Italic" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </WrapPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="3">
                    <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" AlternatingRowBackground="{DynamicResource WindowBackground}" GridLinesVisibility="Horizontal" HeadersVisibility="Column" MinRowHeight="34" RowHeight="{x:Static sys:Double.NaN}" FontSize="12">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox IsThreeState="True" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding DataContext.IsAllSelected,                                                              RelativeSource={RelativeSource AncestorType=Window},                                                              Mode=TwoWay,                                                              UpdateSourceTrigger=PropertyChanged}" ToolTip="Выбрать/снять все (три-состояния: всё/часть/ничего)."/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Наименование" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="4*" IsReadOnly="False" MinWidth="240">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="TextTrimming" Value="None"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Padding" Value="6,4"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="AcceptsReturn" Value="True"/>
                                        <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Лист" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock Text="{Binding SheetNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <Thumb Style="{StaticResource ExcelFillThumb}" DragStarted="SheetFill_DragStarted" DragDelta="SheetFill_DragDelta" DragCompleted="SheetFill_DragCompleted" Tag="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBox Text="{Binding SheetNumber, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextAlignment="Center"/>
                                            <Thumb Style="{StaticResource ExcelFillThumb}" DragStarted="SheetFill_DragStarted" DragDelta="SheetFill_DragDelta" DragCompleted="SheetFill_DragCompleted" Tag="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Формат" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" Padding="8,4">
                                            <TextBlock Text="{Binding Format}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="Нестандартный">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                            </Trigger>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.AllFormatNames, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Format, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="4,2" VerticalContentAlignment="Center" Padding="6,4" IsDropDownOpen="True">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="8,4"/>
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status, Mode=OneWay}" Width="120" IsReadOnly="True" MinWidth="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="OK">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="Готово">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="Ошибка">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="Ошибка валидации">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="PlotInfo Ошибка">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="Публикация...">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="Печать...">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="Готов">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Масштаб" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding PlotScaleIndex}" Margin="0,0,16,0">
                        <ComboBoxItem Content="1:1"/>
                        <ComboBoxItem Content="1:100"/>
                    </ComboBox>
                    <TextBlock Grid.Column="2" Text="Папка PDF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DockPanel Grid.Column="3">
                        <Button DockPanel.Dock="Right" Content="…" Command="{Binding BrowseOutputCommand}" MinWidth="32" Width="32" Padding="4" Margin="6,0,0,0" ToolTip="Выбрать папку PDF"/>
                        <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" ToolTip="Пусто — сохранить рядом с DWG"/>
                    </DockPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
