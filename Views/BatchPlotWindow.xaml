<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:BotPlusAutocadTool.ViewModels" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:ui="clr-namespace:BotPlusAutocadTool.UI" x:Class="BotPlusAutocadTool.Views.BatchPlotWindow" mc:Ignorable="d" x:Name="TheWindow" Title="Пакетная печать форматов" Height="620" Width="1080" MinHeight="340" MinWidth="880" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="{DynamicResource WindowBackground}" SizeToContent="Manual" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource TextPrimary}" Topmost="False" ui:WindowTheme.Enabled="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <vm:InverseBoolConverter x:Key="InverseBool"/>
            <Style x:Key="SearchOrderButton" TargetType="RadioButton">
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Frame" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource HoverBackground}"/></Trigger>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentColor}"/></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentColor}"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ExcelFillThumb" TargetType="Thumb">
                <Setter Property="Width" Value="10"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Bottom"/>
                <Setter Property="Cursor" Value="Cross"/>
                <Setter Property="Opacity" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="1"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=IsMouseOver}" Value="True">
                        <Setter Property="Opacity" Value="1"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel x:Name="PrintDock" LastChildFill="True" Background="{DynamicResource WindowBackground}">
        <Border DockPanel.Dock="Bottom" Height="44" Margin="12,4,12,10" Padding="6" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" TextElement.FontSize="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <StackPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="28"/><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="8,3"/><Setter Property="Margin" Value="4,0"/></Style>
                </StackPanel.Resources>
                <Button Content="Обновить" Command="{Binding RefreshCommand}"/>
                <Button Content="Таблица в модель" Command="{Binding InsertIndexCommand}" ToolTip="Вставить ведомость выбранных чертежей в модель"/>
                <Button Content="Записать атрибуты" Command="{Binding UpdateAttributesCommand}"/>
                <CheckBox Content="В фоне" IsChecked="{Binding PlotInBackground}" VerticalAlignment="Center" Margin="10,0"/>
                <Button Content="PDF-сшивка" Command="{Binding PlotCommand}"/>
                <Button Content="PDF по листам" Command="{Binding PlotBySheetsCommand}"/>
            </StackPanel>
        </Border>
        <Border x:Name="PrintToolbar" DockPanel.Dock="Top" Height="104" Margin="12,10,12,6" Padding="8,6" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="3" TextElement.FontSize="12">
            <Border.Resources>
                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Height" Value="28"/><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="6,2"/></Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Height" Value="28"/><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="6,2"/></Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="28"/><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="8,3"/></Style>
                <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
            </Border.Resources>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="32"/><RowDefinition Height="28"/></Grid.RowDefinitions>
                <Grid IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="76"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="210"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Масштаб" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding PlotScaleIndex}"><ComboBoxItem Content="1:1"/><ComboBoxItem Content="1:100"/></ComboBox>
                    <TextBlock Grid.Column="2" Text="{Binding PlotStyleLabel}" Margin="12,0,6,0"/>
                    <ComboBox x:Name="PlotStyleSelector" Grid.Column="3" ItemsSource="{Binding PlotStyleChoices}" SelectedItem="{Binding SelectedPlotStyle}" ToolTip="Таблица стилей печати этого AutoCAD. Из DWG — настройки модели; без стиля — исходные цвета объектов." ClipToBounds="True"/>
                    <TextBlock Grid.Column="4" Text="Папка PDF" Margin="12,0,6,0"/>
                    <TextBox Grid.Column="5" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" ToolTip="Пусто — сохранить рядом с DWG"/>
                    <Button Grid.Column="6" Content="…" Command="{Binding BrowseOutputCommand}" Margin="4,0,0,0" Padding="4" ToolTip="Выбрать папку PDF"/>
                </Grid>
                <Grid Grid.Row="1" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Единицы DWG" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding DrawingUnitChoices}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding DrawingUnitsChoice}" ToolTip="{Binding DrawingUnitsDescription}"/>
                    <TextBlock Grid.Column="2" Text="{Binding DrawingUnitsSummary}" TextTrimming="CharacterEllipsis" Margin="8,0" ToolTip="{Binding DrawingUnitsDescription}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Style.Triggers><DataTrigger Binding="{Binding DrawingUnitsWarning}" Value="True"><Setter Property="Foreground" Value="#E9A547"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <CheckBox Grid.Column="3" Content="Прозрачность" IsChecked="{Binding PlotTransparency}" VerticalAlignment="Center" Margin="4,0,10,0" ToolTip="Учитывать прозрачность объектов и слоёв"/>
                    <Button Grid.Column="4" Content="Указать форматку" Command="{Binding SetFormatkaCommand}" Margin="0,0,6,0" ToolTip="Выбрать блок, имя и слой которого станут фильтром поиска"/>
                    <Button Grid.Column="5" Content="Выбрать форматки" Command="{Binding SelectFormatkiCommand}"/>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Порядок:" Margin="0,0,6,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                        <RadioButton Content="↓ Сверху вниз" GroupName="SearchOrder" Style="{StaticResource SearchOrderButton}" IsChecked="{Binding IsTopToBottom, Mode=TwoWay}" ToolTip="По строкам сверху вниз; внутри строки — слева направо."/>
                        <RadioButton Content="↑ Снизу вверх" GroupName="SearchOrder" Style="{StaticResource SearchOrderButton}" IsChecked="{Binding IsBottomToTop, Mode=TwoWay}" ToolTip="По строкам снизу вверх; внутри строки — слева направо."/>
                        <RadioButton Content="→ Слева направо" GroupName="SearchOrder" Style="{StaticResource SearchOrderButton}" IsChecked="{Binding IsLeftToRight, Mode=TwoWay}" ToolTip="По столбцам слева направо; внутри столбца — сверху вниз."/>
                        <RadioButton Content="← Справа налево" GroupName="SearchOrder" Style="{StaticResource SearchOrderButton}" IsChecked="{Binding IsRightToLeft, Mode=TwoWay}" ToolTip="По столбцам справа налево; внутри столбца — сверху вниз."/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" ToolTip="{Binding StatusMessage}"/>
                    <ProgressBar Grid.Column="3" IsIndeterminate="True" Width="60" Height="6" Margin="8,0,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Grid>
        </Border>
                <Border x:Name="PlotItemsViewport" Margin="12,0,12,0" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="3">
                    <DataGrid x:Name="FramesGrid" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" AlternatingRowBackground="{DynamicResource WindowBackground}" GridLinesVisibility="Horizontal" HeadersVisibility="Column" MinRowHeight="34" RowHeight="{x:Static sys:Double.NaN}" FontSize="12">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox IsThreeState="True" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding DataContext.IsAllSelected,                                                              RelativeSource={RelativeSource AncestorType=Window},                                                              Mode=TwoWay,                                                              UpdateSourceTrigger=PropertyChanged}" ToolTip="Выбрать/снять все (три-состояния: всё/часть/ничего)."/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Наименование" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="4*" IsReadOnly="False" MinWidth="240">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="TextTrimming" Value="None"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Padding" Value="6,4"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="AcceptsReturn" Value="True"/>
                                        <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Лист" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock Text="{Binding SheetNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <Thumb Style="{StaticResource ExcelFillThumb}" DragStarted="SheetFill_DragStarted" DragDelta="SheetFill_DragDelta" DragCompleted="SheetFill_DragCompleted" Tag="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBox Text="{Binding SheetNumber, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextAlignment="Center"/>
                                            <Thumb Style="{StaticResource ExcelFillThumb}" DragStarted="SheetFill_DragStarted" DragDelta="SheetFill_DragDelta" DragCompleted="SheetFill_DragCompleted" Tag="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Формат" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" Padding="8,4">
                                            <TextBlock Text="{Binding Format}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="Нестандартный">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                            </Trigger>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.AllFormatNames, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Format, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="4,2" VerticalContentAlignment="Center" Padding="6,4" IsDropDownOpen="True">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="8,4"/>
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status, Mode=OneWay}" Width="120" IsReadOnly="True" MinWidth="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="OK">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="Готово">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="Ошибка">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="Ошибка валидации">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="PlotInfo Ошибка">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="Публикация...">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="Печать...">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="Готов">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
    </DockPanel>
</Window>
